# ============================================================================
# Concord — ORTAM DEĞİŞKENLERİ
# ============================================================================
# ŞABLON — bunu .env olarak kopyala ve gerçek değerleri doldur. Anahtarları yeniden üretmek için:
#     cd apps/api && go run ./cmd/genkeys
#
# Aşağıdaki anahtarlar crypto/rand ile üretildi (elle "rastgele" yazmak en yaygın
# hatalardan biri — insan üretimi diziler tahmin edilebilir).
# İstediğin zaman buradan değiştirebilirsin; servisler yeniden başlayınca alır.
# ============================================================================

# ---- Ortam ----
NODE_ENV=development
API_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=concord
POSTGRES_PASSWORD=concord_dev
POSTGRES_DB=concord
POSTGRES_DSN=postgres://concord:concord_dev@localhost:5433/concord?sslmode=disable

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# GÜVENLİK ANAHTARLARI — üretimde MUTLAKA değiştir (bunlar bu makineye özgü üretildi)
# ============================================================================

# JWT imzalama. API, Gateway ve Voice AYNI değeri kullanmalı — farklıysa WS 403 verir.
JWT_SECRET=DEGISTIR_genkeys_ile_uret

# Voice ↔ API arası çağrılar (x-voice-secret)
VOICE_CONTROL_SECRET=DEGISTIR_genkeys_ile_uret

# Voice node'ları arası pipe pazarlığı (FAZ C cascade). Kimliksiz kalırsa yabancı biri
# kanalın RTP akışını çekebilir.
VOICE_CLUSTER_SECRET=DEGISTIR_genkeys_ile_uret

# MinIO → API medya webhook'u. BOŞSA webhook kapanır ve dosyalar virüs taramasından
# geçmeden iliştirilebilir (üretimde MustSecure zorunlu kılar).
MEDIA_EVENT_SECRET=DEGISTIR_genkeys_ile_uret

# Gateway (Phoenix) imzası
SECRET_KEY_BASE=DEGISTIR_genkeys_ile_uret

# Erlang küme çerezi — gateway replica'ları bununla el sıkışır (FAZ D)
RELEASE_COOKIE=DEGISTIR_genkeys_ile_uret

# ============================================================================
# ARAMA (Meilisearch) — üretimde ZORUNLU
# ============================================================================
# Postgres FTS yedeği CJK'yı kelimelere ayıramaz → Japonca/Çince/Korece kullanıcılar
# için arama HİÇ çalışmaz. MustSecure üretimde MEILI_ADDR'i şart koşar.
MEILI_ADDR=http://localhost:7700
MEILI_MASTER_KEY=DEGISTIR_genkeys_ile_uret
MEILI_KEY=DEGISTIR_genkeys_ile_uret

# ============================================================================
# E-POSTA (SMTP) — şifre sıfırlama + e-posta doğrulama
# ============================================================================
# DEV: MailHog (docker compose ile gelir). Arayüz: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=false
MAIL_FROM=Concord <no-reply@concord.local>

# ---- ÜRETİM / GERÇEK GMAIL için (yukarıdakileri değiştir) --------------------
# Gmail App Password ŞART — normal Gmail parolan ÇALIŞMAZ (Google 2022'den beri
# "daha az güvenli uygulama" erişimini kapattı).
#
# App Password nasıl alınır (2 dakika, SENİN yapman gerekiyor — 2FA'lı interaktif giriş
# istiyor, ben programatik olarak alamam):
#   1. https://myaccount.google.com/security → "2 Adımlı Doğrulama"yı AÇ (zorunlu ön koşul)
#   2. https://myaccount.google.com/apppasswords → uygulama adı: "Concord" → Oluştur
#   3. Çıkan 16 haneli kodu (boşlukları sil) aşağıya SMTP_PASS olarak yapıştır
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                      # 587 = STARTTLS, 465 = implicit TLS (ikisi de destekli)
# SMTP_USER=sen@gmail.com
# SMTP_PASS=BURAYA_16_HANELI_APP_PASSWORD
# SMTP_REQUIRE_TLS=true              # üretimde ZORUNLU (MustSecure kontrol eder)
# MAIL_FROM=Concord <sen@gmail.com>
#
# NOT: Gmail günde ~500 mail sınırı koyar. Kullanıcı sayısı artınca aşağıdaki profesyonel
# sağlayıcılardan birine geç — aynı SMTP_* değişkenleri onlarda da çalışır (kod değişmez).
#
# ============================================================================
# PROFESYONEL YOL — kendi domain + transactional mail servisi (ÖNERİLEN)
# ============================================================================
# Ciddi şirketler şifre sıfırlama maillerini kişisel Gmail ile GÖNDERMEZ. Profesyonel
# kurulum: bir domain (ör. concord.app) + transactional mail servisi → no-reply@concord.app.
# Tam adım adım rehber (domain, DNS, DKIM/SPF/DMARC): docs/SMTP-KURULUM.md
#
# --- Seçenek A: Resend (en kolay, ücretsiz 3.000 mail/ay) --------------------
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_RESEND_API_KEY
# SMTP_REQUIRE_TLS=true
# MAIL_FROM=Concord <no-reply@concord.app>
#
# --- Seçenek B: Amazon SES (en ucuz ölçek) ----------------------------------
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com   # bölgene göre
# SMTP_PORT=587
# SMTP_USER=SES_SMTP_USERNAME
# SMTP_PASS=SES_SMTP_PASSWORD
# SMTP_REQUIRE_TLS=true
# MAIL_FROM=Concord <no-reply@concord.app>
#
# --- Seçenek C: Postmark (en yüksek deliverability) -------------------------
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=POSTMARK_SERVER_TOKEN
# SMTP_PASS=POSTMARK_SERVER_TOKEN
# SMTP_REQUIRE_TLS=true
# MAIL_FROM=Concord <no-reply@concord.app>

# ============================================================================
# PUSH BİLDİRİMİ
# ============================================================================
# VAPID — Web Push (tarayıcı). P-256 ECDSA çifti; genkeys üretti.
# VAPID_PUBLIC_KEY istemciye verilir, PRIVATE asla.
VAPID_PUBLIC_KEY=DEGISTIR_genkeys_ile_uret
VAPID_PRIVATE_KEY=DEGISTIR_genkeys_ile_uret
VAPID_SUBJECT=mailto:admin@ornek.com

# Expo Push (mobil) — yalnızca "enhanced security" açıksa gerekir; boş kalabilir.
EXPO_ACCESS_TOKEN=

# ============================================================================
# NESNE DEPOSU (MinIO)
# ============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=concord
MINIO_SECRET_KEY=concord_dev_minio
MINIO_BUCKET=concord-uploads
MINIO_PUBLIC_BASE=http://localhost:9000

# ============================================================================
# DİĞER
# ============================================================================
# Virüs tarama (ClamAV). Boşsa tarama ATLANIR (dev); üretimde doldurulmalı.
CLAMAV_ADDR=localhost:3310

# Rate limit (istek/dakika, PER-IP kaba tavan). Asıl brute-force savunması hesap
# kapsamlıdır (handlers/auth.go) — bu çit CGNAT'ı boğmayacak kadar gevşek tutulur.
AUTH_RATE_LIMIT_PER_MIN=60
API_RATE_LIMIT_PER_MIN=600

# Snowflake ID üreteci — her API instance'ı FARKLI olmalı (k8s'te StatefulSet pod indeksi)
WORKER_ID=1

# GitHub OAuth (Connections) — boşsa GitHub doğrulaması kapalı, elle ekleme çalışır
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Grafana
GRAFANA_PASSWORD=DEGISTIR_genkeys_ile_uret
