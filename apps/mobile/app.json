{
  "expo": {
    "name": "Sidcord",
    "slug": "sidcord",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sidcord",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sidcord.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sesli sohbet için mikrofon erişimi gerekir.",
        "NSCameraUsageDescription": "Görüntülü görüşme ve avatar için kamera erişimi gerekir."
      }
    },
    "android": {
      "package": "com.sidcord.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@config-plugins/react-native-webrtc"
    ]
  }
}
